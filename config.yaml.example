# smugVision Configuration File
# 
# This is an example configuration file for smugVision.
# Copy this file to '~/.smugvision/config.yaml' and fill in your values:
#   mkdir -p ~/.smugvision
#   cp config.yaml.example ~/.smugvision/config.yaml
#
# This keeps all smugVision configuration files in one place, alongside
# relationships.yaml and geocoding_config.yaml.

# SmugMug API Configuration
# Obtain your API credentials from https://api.smugmug.com/api/developer/apply
smugmug:
  api_key: "YOUR_API_KEY_HERE"
  api_secret: "YOUR_API_SECRET_HERE"
  user_token: "YOUR_USER_TOKEN_HERE"
  user_secret: "YOUR_USER_SECRET_HERE"

# Vision Model Configuration
#
# Any vision-capable model served by Ollama works - there is no allow-list in the
# code. Run `ollama list` to see what you have installed, and `ollama pull <name>`
# to add one. Values shown here are the shipped defaults from
# smugvision/config/defaults.py; every key you omit falls back to that default.
vision:
  model: "qwen3-vl:8b"               # Any model from `ollama list` (see defaults.py)
  # endpoint: "http://localhost:11434"  # Ollama API endpoint. Leave unset (the
                                     # shipped default is null) to let the ollama
                                     # client use $OLLAMA_HOST, falling back to
                                     # http://localhost:11434. Setting it here
                                     # overrides $OLLAMA_HOST.
  temperature: 0.7                   # Sampling temperature (0.0-1.0)
  max_tokens: 500                    # Token budget for ONE response holding caption + tags
  timeout: 120                       # Request timeout in seconds

  # --- Behaviour / performance knobs ---

  # Ollama's `think` parameter, passed straight through.
  # false            - disable reasoning (default; recommended)
  # "low"/"medium"/"high" - reasoning budget on models that support it
  # null             - omit the parameter and let the model decide
  # Reasoning models can spend the entire max_tokens budget thinking and return an
  # empty response. If that happens, keep think: false or raise max_tokens a lot.
  think: false

  # How long Ollama keeps the model loaded after a request. Without this the model
  # can unload between images, so every image pays load time instead of just the
  # first one in an album. Accepts a duration string or seconds; null omits it.
  keep_alive: "30m"

  # true  - one request returns the caption AND the tags together (default)
  # false - legacy path: a separate caption request and tags request per image
  # Flip to false only if a model produces noticeably worse output when asked for
  # both at once.
  single_call: true

  # true  - constrain the reply with a JSON schema so it parses deterministically
  # false - free-text reply parsed with the legacy CAPTION:/TAGS: heuristics
  # Flip to false for older or smaller models that ignore or mishandle JSON schema
  # constraints. This is a compatibility fallback, not a neutral choice:
  # unconstrained output tends to ramble toward max_tokens and is slower.
  structured_output: true

  # Downscale the image's long edge to this many pixels before base64 encoding.
  # Vision models tile input to roughly 1024-1568px, so sending a 3840px original
  # is wasted bandwidth and memory. 0 or null disables; images are never upscaled.
  max_image_dimension: 1568
  jpeg_quality: 85                   # JPEG quality used when re-encoding for transport

  # Warn (never fail) at startup if `model` is not in Ollama's tag list.
  validate_model: true

# Face Recognition Configuration
face_recognition:
  enabled: true                      # Enable/disable face recognition
  reference_faces_dir: "~/.smugvision/reference_faces"  # Directory with reference face images

  # Embedding backend: "dlib" (default) or "insightface".
  # "insightface" (ArcFace via ONNX Runtime) is OPTIONAL and EXPERIMENTAL. It needs
  # extra packages: pip install -e ".[insightface]". If it is unavailable the code
  # logs an error and falls back to dlib rather than failing the run.
  backend: "dlib"

  # --- dlib-only settings (ignored by the insightface backend) ---
  # KNOWN GAP: these three are not currently forwarded from config to the recognizer,
  # so the built-in defaults below apply whatever you set here. To actually change
  # them today, put them in a `dlib:` sub-block (see the bottom of this section),
  # which IS passed through as backend options.
  tolerance: 0.6                     # Euclidean distance ceiling (lower = stricter)
  model: "cnn"                       # dlib DETECTOR, not the backend: 'hog' or 'cnn'
  detection_scale: 0.5               # Image scale for detection (0.1-1.0, lower = faster)

  # --- backend-agnostic ---
  min_confidence: 0.25               # Minimum normalized confidence 0.0-1.0 to name a person
  use_cache: true                    # Cache reference face encodings between runs
  cache_dir: "~/.smugvision/cache/face_encodings"  # Where those encodings are pickled

  # --- per-backend option blocks ---
  # The block named after the active backend is passed to it as options.
  #
  # Uncomment to actually change the dlib settings (see the KNOWN GAP note above):
  # dlib:
  #   tolerance: 0.5
  #   model: "hog"
  #   detection_scale: 0.75

  # Only read when backend: "insightface".
  insightface:
    model_name: "buffalo_l"          # InsightFace model pack (downloaded on first use)
    det_size: [640, 640]             # Detector input size; larger finds smaller faces
    similarity_threshold: 0.4        # COSINE similarity - HIGHER is stricter.
                                     # Not interchangeable with `tolerance` above.

# Processing Configuration
processing:
  marker_tag: "smugvision"           # Tag to mark processed images
  generate_captions: true            # Generate image captions
  generate_tags: true                # Generate keyword tags
  preserve_existing: true            # Keep existing captions/tags when adding new ones
  image_size: "Medium"               # Download size from SmugMug (Small, Medium, Large,
                                     # X2Large, Original, ...). Case-insensitive.
  use_exif_location: true            # Extract and use GPS location from EXIF

# Location Resolution Configuration
# Custom locations allow you to define friendly names for places like your home,
# relatives' houses, or frequently visited locations. These override reverse geocoding.
# See locations.yaml.example for the custom locations file format.
location:
  custom_locations_file: "~/.smugvision/locations.yaml"  # Path to custom locations file
  check_custom_first: true           # Check custom locations before reverse geocoding
  use_aliases_as_tags: true          # Add location aliases as keyword tags

# Prompt Configuration
# Customize these prompts to change how the AI describes your images.
# The values below are the shipped defaults (smugvision/config/defaults.py).
#
# These are INSTRUCTIONS, not the whole prompt: album name, resolved location,
# recognized people and any relationships from ~/.smugvision/relationships.yaml are
# appended as context by the vision layer before the request is sent.
#
# Note on formatting instructions: with `structured_output: true` a JSON schema
# already forces the shape of the reply, so the "output ONLY a comma-separated
# list" / "no introductions" boilerplate is redundant there. It still matters when
# `structured_output: false`, which is why the defaults keep it.
prompts:
  caption: |
    You are a photo captioning assistant. Write exactly ONE caption (1-2 sentences)
    for this image. Describe the main subject, setting, and activity.
    IMPORTANT: Output ONLY the caption text. No options, no explanations, no
    introductions like 'Here is...' - just the caption itself.

  tags: |
    Output a comma-separated list of 5-10 keyword tags for this image.
    IMPORTANT: Output ONLY the tags separated by commas. No explanations,
    no numbering, no extra text. Example output: dog, playing, park, sunny, happy

# Cache Configuration
cache:
  directory: "~/.smugvision/cache"   # Local image cache directory
  clear_on_exit: false               # Automatically clear cache after processing
  preserve_structure: true           # Mirror SmugMug folder structure in cache

# Logging Configuration
logging:
  level: "INFO"                      # Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
  file: "~/.smugvision/smugvision.log"  # Log file path
  format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"  # Log message format

